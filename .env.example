# ── Required ──────────────────────────────────────────
# MongoDB Atlas connection string (free M0 cluster)
# Get yours at: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/familytree?retryWrites=true&w=majority

# Session encryption key (auto-generated on Render)
SESSION_SECRET=change-me-to-a-random-string

# ── Production (set on Render dashboard) ──────────────
NODE_ENV=production
PORT=5000

# Your Render URL (set after first deploy)
CLIENT_URL=https://your-app-name.onrender.com

# ── Facebook OAuth (optional — demo login works without it) ──
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=https://your-app-name.onrender.com/api/auth/facebook/callback
